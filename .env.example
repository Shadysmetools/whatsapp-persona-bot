# Copy to .env and edit. All values are optional.

# Your name as it should appear to the model
OWNER_NAME=Shady

# Local Ollama model
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b
NUM_CTX=8192

# How many past messages per contact the bot remembers
HISTORY_TURNS=20

# Search the web when a contact asks something factual
RESEARCH_ENABLED=true

# If true, the bot openly says it's your assistant. If false it texts as you,
# but it still never denies being an assistant when someone sincerely asks.
DISCLOSE_AI=false

# Quiet hours (24h clock, local time) - no replies, messages stay unread
QUIET_HOURS_START=1
QUIET_HOURS_END=9

# Safety cap on replies per day across all contacts
DAILY_REPLY_CAP=150

# Wait this long after a contact's last message before replying (bursts get one reply)
BURST_WAIT_SECONDS=8

# When you type in a chat yourself, the bot stays out of that chat for this long
TAKEOVER_PAUSE_MINUTES=60
